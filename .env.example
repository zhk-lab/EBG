# Select profiles independently for prediction and judging.
EBG_MODEL_PROFILE=GPT_LUNA
JUDGE_MODEL_PROFILE=QWEN

# Replace model IDs, URLs and keys with values accepted by your gateway.
GPT_BASE_URL=https://your-gateway.example/v1
GPT_API_KEY=
GPT_LUNA_MODEL_NAME=your-luna-model
GPT_TERRA_MODEL_NAME=your-terra-model
GPT_SOL_MODEL_NAME=your-sol-model
GPT_REASONING_EFFORT=none

DEEPSEEK_PRO_BASE_URL=https://your-gateway.example/v1
DEEPSEEK_PRO_MODEL_NAME=your-deepseek-model
DEEPSEEK_PRO_API_KEY=
DEEPSEEK_PRO_THINKING_TYPE=disabled

QWEN_BASE_URL=https://your-gateway.example/v1
QWEN_MODEL_NAME=your-qwen-model
QWEN_API_KEY=
QWEN_ENABLE_THINKING=false

KIMI_BASE_URL=https://your-gateway.example/v1
KIMI_MODEL_NAME=your-kimi-model
KIMI_API_KEY=
KIMI_THINKING_MODE=required
KIMI_REASONING_EFFORT=low

# Optional per-role sampling overrides. Omitted fields use provider defaults.
# EBG_TEMPERATURE=0
# JUDGE_TEMPERATURE=0
# EBG_TOP_P=omit
# JUDGE_TOP_P=omit
