{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BEG Static Graph",
  "oneOf": [
    {"$ref": "#/$defs/repo_graph"},
    {"$ref": "#/$defs/trace_graph"}
  ],
  "$defs": {
    "lines": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^E[0-9]{6}$"}
    },
    "code_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "symbol", "line_start", "line_end"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1}
      }
    },
    "trace_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "event_index", "event_type", "tool_name", "original_evidence_id"],
      "properties": {
        "turn": {"type": "integer", "minimum": 0},
        "event_index": {"type": "integer", "minimum": 0},
        "event_type": {"enum": ["system", "user_prompt", "assistant_response", "tool_exchange"]},
        "tool_name": {"type": ["string", "null"], "minLength": 1},
        "original_evidence_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "code_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_type", "locator", "content"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^E[0-9]{6}$"},
        "source_type": {"const": "code"},
        "locator": {"$ref": "#/$defs/code_locator"},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "trace_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_type", "locator", "content"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^E[0-9]{6}$"},
        "source_type": {"const": "trace"},
        "locator": {"$ref": "#/$defs/trace_locator"},
        "content": {"type": "string"}
      }
    },
    "repo_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavior_id", "artifact_kind", "path", "symbol", "symbol_lines",
        "result_type", "trigger_evidence_ids", "operation_evidence_ids",
        "result_evidence_ids"
      ],
      "properties": {
        "behavior_id": {"type": "string", "pattern": "^B[0-9]{4,}$"},
        "artifact_kind": {"enum": ["source", "runtime_template", "executable", "configuration"]},
        "path": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "symbol_lines": {"$ref": "#/$defs/lines"},
        "result_type": {"enum": ["return", "raise", "state_write", "output", "external_call", "yield"]},
        "trigger_evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "operation_evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "result_evidence_ids": {
          "allOf": [
            {"$ref": "#/$defs/evidence_ids"},
            {"minItems": 1}
          ]
        }
      }
    },
    "trace_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavior_id", "task_id", "sequence_index", "start_turn", "end_turn",
        "demand_refs", "action_evidence_ids", "response_refs"
      ],
      "properties": {
        "behavior_id": {"type": "string", "pattern": "^T[0-9]{4,}$"},
        "task_id": {"type": "string", "pattern": "^K[0-9]{4,}$"},
        "sequence_index": {"type": "integer", "minimum": 1},
        "start_turn": {"type": "integer", "minimum": 0},
        "end_turn": {"type": "integer", "minimum": 0},
        "demand_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_id"],
            "properties": {
              "evidence_id": {"type": "string", "pattern": "^E[0-9]{6}$"},
              "char_range": {
                "type": "array",
                "prefixItems": [
                  {"type": "integer", "minimum": 0},
                  {"type": "integer", "minimum": 1}
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "action_evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "response_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_id"],
            "properties": {
              "evidence_id": {"type": "string", "pattern": "^E[0-9]{6}$"},
              "char_range": {
                "type": "array",
                "prefixItems": [
                  {"type": "integer", "minimum": 0},
                  {"type": "integer", "minimum": 1}
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      },
      "anyOf": [
        {"properties": {"action_evidence_ids": {"minItems": 1}}},
        {"properties": {"response_refs": {"minItems": 1}}}
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "symbol"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}
      }
    },
    "repo_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from", "type", "to", "via", "evidence_ids"],
      "properties": {
        "edge_id": {"type": "string", "pattern": "^R[0-9]{4,}$"},
        "from": {"$ref": "#/$defs/endpoint"},
        "type": {"enum": ["calls", "feeds"]},
        "to": {"$ref": "#/$defs/endpoint"},
        "via": {"type": ["string", "null"], "minLength": 1},
        "evidence_ids": {
          "allOf": [
            {"$ref": "#/$defs/evidence_ids"},
            {"minItems": 1}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "calls"}}},
          "then": {"properties": {"via": {"type": "null"}}}
        }
      ]
    },
    "trace_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "source_task_id", "type", "target_task_id", "evidence_ids"],
      "properties": {
        "edge_id": {"type": "string", "pattern": "^R[0-9]{4,}$"},
        "source_task_id": {"type": "string", "pattern": "^K[0-9]{4,}$"},
        "type": {"enum": ["informs", "supersedes"]},
        "target_task_id": {"type": "string", "pattern": "^K[0-9]{4,}$"},
        "evidence_ids": {
          "allOf": [
            {"$ref": "#/$defs/evidence_ids"},
            {"minItems": 1}
          ]
        }
      }
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "path", "symbol", "lines", "source"],
      "properties": {
        "artifact_kind": {"enum": ["source", "runtime_template", "executable", "configuration"]},
        "path": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "lines": {"$ref": "#/$defs/lines"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "repo_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "benchmark", "evidence", "behaviors", "source_contexts", "edges"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "benchmark": {"enum": ["specgap", "silentswap"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/code_evidence"}},
        "behaviors": {"type": "array", "items": {"$ref": "#/$defs/repo_behavior"}},
        "source_contexts": {"type": "array", "items": {"$ref": "#/$defs/source_context"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/repo_edge"}}
      }
    },
    "trace_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "benchmark", "evidence", "behaviors", "edges"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "benchmark": {"const": "feedbacktrace"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/trace_evidence"}},
        "behaviors": {"type": "array", "items": {"$ref": "#/$defs/trace_behavior"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/trace_edge"}}
      }
    }
  }
}
