{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BEG SilentSwap Prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_id", "benchmark", "swaps"],
  "properties": {
    "input_id": {"type": "string", "minLength": 1},
    "benchmark": {"const": "silentswap"},
    "swaps": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/swap"}
    }
  },
  "$defs": {
    "swap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "swap_type",
        "code_change",
        "trigger_condition",
        "behavioral_effect"
      ],
      "properties": {
        "target": {"$ref": "#/$defs/target"},
        "swap_type": {
          "enum": [
            "input_validation_boundary",
            "parsing_matching",
            "ordering_precedence",
            "default_null_fallback",
            "exception_error_handling",
            "state_identity_lifecycle",
            "representation_normalization",
            "dispatch_routing_aggregation"
          ]
        },
        "code_change": {"type": "string", "minLength": 1},
        "trigger_condition": {"type": "string", "minLength": 1},
        "behavioral_effect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": {"type": "string", "minLength": 1},
            "after": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "symbol", "line_ranges"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "symbol": {"$ref": "#/$defs/symbol"},
        "line_ranges": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/line_range"}
        }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "qualified_name"],
      "properties": {
        "kind": {"enum": ["function", "method", "class", "field", "module"]},
        "qualified_name": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "module"}}},
          "then": {"properties": {"qualified_name": {"maxItems": 0}}},
          "else": {"properties": {"qualified_name": {"minItems": 1}}}
        }
      ]
    },
    "line_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 1},
        "end": {"type": "integer", "minimum": 1}
      }
    }
  }
}
