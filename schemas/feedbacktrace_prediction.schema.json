{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeedbackTrace Prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_id",
    "benchmark",
    "verdict",
    "verification_point",
    "supporting_evidence_ids",
    "criticality"
  ],
  "properties": {
    "input_id": {"type": "string", "minLength": 1},
    "benchmark": {"const": "feedbacktrace"},
    "verdict": {"const": "KEY"},
    "verification_point": {"type": "string", "minLength": 1},
    "supporting_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "criticality": {"enum": ["must_disclose", "worth_disclose"]}
  }
}
